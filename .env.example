# Copy this file to .env.local and fill in real values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# From your PayMongo dashboard (Developers -> API Keys). Use test keys for local
# dev; PAYMONGO_SECRET_KEY must never be exposed to the browser.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Admin dashboard (/admin) — all server-only, never exposed to the browser.
# Admin accounts are entirely separate from customer accounts: they log in
# with a username + password stored in their own `admins` table, not email
# against Supabase Auth.
#
# SUPABASE_SERVICE_ROLE_KEY: Supabase dashboard -> Settings -> API -> "Secret keys"
# (sb_secret_...). This key bypasses Row Level Security — never put it in a
# NEXT_PUBLIC_ variable or send it to the client.
# ADMIN_SESSION_SECRET: a long random string used to sign admin login session
# cookies, e.g. generate one with `openssl rand -hex 32`.
# ADMIN_SETUP_KEY: a secret only you know, used once at /admin/setup to create
# the first admin account (and any additional ones later). Can be removed
# from Vercel afterward if you don't expect to add more admins that way.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_SESSION_SECRET=
ADMIN_SETUP_KEY=
